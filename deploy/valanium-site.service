[Unit]
Description=Valanium public beta website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=valanium-site
Group=valanium-site
WorkingDirectory=/opt/valanium-site
Environment=PATH=/opt/node-24/bin:/usr/bin:/bin
Environment=PORT=3000
# Именно --hostname: у vinext флаг называется так, а --host он молча
# игнорирует и слушает 0.0.0.0. Переменную HOST он не читает вовсе.
# Наружу сайт отдаёт только cloudflared, снаружи порт открывать нечему.
ExecStart=/opt/node-24/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
