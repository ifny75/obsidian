# /etc/systemd/system/obsidian-backup.service
#
# Снимок базы. Обычный cp здесь не годится: база в режиме WAL, и файл, снятый
# во время записи, окажется битым. Инструмент делает VACUUM INTO — консистентный
# снимок на работающем сервере, без остановки.
#
# Путь к node может отличаться: системный часто старее 24, а серверу нужен
# именно 24+. Подставьте свой (например /opt/node-24/bin/node).

[Unit]
Description=Obsidian backup snapshot
After=obsidian.service

[Service]
Type=oneshot
User=obsidian
Group=obsidian
WorkingDirectory=/opt/obsidian
ExecStart=/usr/bin/node --env-file-if-exists=.env src/tools/backup.ts /var/backups/obsidian

# Сколько снимков держать. Старые чистятся сами.
Environment=OBSIDIAN_BACKUP_KEEP=14

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/obsidian/data /var/backups/obsidian
