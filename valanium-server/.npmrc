# Несовпадение версии Node обязано валить установку, а не оставаться
# предупреждением. Сервер опирается на node:sqlite, разбор TypeScript без
# сборки и --env-file-if-exists — под Node 20 он не запустится вовсе, но
# ошибка вылезет уже при старте и будет выглядеть как невнятный SyntaxError
# в .ts. Лучше отказать сразу и назвать причину.
engine-strict=true
