# Скопировать в .env и править под себя. Файл .env в git не попадает.

# Слушаем только петлю: наружу торчит cloudflared, а не сам сервер.
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=8787

OBSIDIAN_DB=data/obsidian.db
OBSIDIAN_BLOBS=data/blobs

# Ключ для столбцов, которые сервер обязан читать сам (секреты вторых факторов).
# Пусто => ключ заводится сам в файле data/secret.key рядом с базой. Этот файл
# НЕ входит в бэкап базы намеренно: иначе шифрование столбца теряет смысл.
# Потеряете его — вторые факторы придётся заводить заново.
OBSIDIAN_SECRET_KEY=

# Cloudflare рвёт WS после ~100 с тишины. Меньше 30 с смысла нет, больше 45 — опасно.
OBSIDIAN_HEARTBEAT_SEC=30
OBSIDIAN_IDLE_TIMEOUT_SEC=90

OBSIDIAN_MAX_FRAME=1048576
OBSIDIAN_MAX_BLOB=16777216

OBSIDIAN_ENVELOPE_TTL_SEC=1209600
OBSIDIAN_BLOB_TTL_SEC=2592000
OBSIDIAN_INVITE_TTL_SEC=604800

# Public Beta: true разрешает первую регистрацию без инвайта.
OBSIDIAN_PUBLIC_REGISTRATION=false
OBSIDIAN_WINDOWS_VERSION=0.6.3
OBSIDIAN_WINDOWS_URL=https://getobsidian.xyz/downloads/Obsidian-Setup.exe
OBSIDIAN_ANDROID_VERSION=0.5.6
OBSIDIAN_ANDROID_URL=https://getobsidian.xyz/downloads/Obsidian.apk

# error | warn | info | debug
# Владельцы сервера: ключи личности (identity) в hex через запятую.
#
# Именно identity, а не юзернейм: имя можно освободить и занять заново, и
# привязка к нему означала бы, что права достаются тому, кто первым перехватит
# освободившееся имя. Пустая строка = панели нет ни у кого.
#
# Свой ключ видно в клиенте: Мой профиль -> Ключ личности (нажатие копирует).
OBSIDIAN_ADMINS=

OBSIDIAN_LOG=info

# --- вход: кто перед нами и откуда ------------------------------------------
# Кому верить, когда он представляется за клиента. `CF-Connecting-IP` и жетон
# `X-Obsidian-Client` принимаются ТОЛЬКО от адресов из этого списка — иначе их
# подделает любой, кто дотянется до сервера мимо туннеля.
#
# По умолчанию это петля: cloudflared ходит с localhost. Ставите свой обратный
# прокси или входной узел — впишите его адрес сюда, иначе лимиты будут считаться
# по одному адресу на всех. Лишнего сюда не вписывайте: каждый адрес в списке —
# это тот, кто может назначить любому запросу любого клиента.
OBSIDIAN_TRUSTED_PROXIES=127.0.0.1,::1,::ffff:127.0.0.1

# Onion-адреса входных узлов через запятую: сервер называет их клиенту в HELLO.
# Пусто => клиент обойдётся зашитым запасным адресом.
OBSIDIAN_ONION_HOSTS=

# Сколько живёт выданный nonce, секунды.
OBSIDIAN_NONCE_TTL_SEC=30

# --- потолки соединений ------------------------------------------------------
# Сокетов с одного адреса. 32 — с запасом на общий NAT: за адресом живёт целая
# квартира или офис, и резать их до единиц значит выключить мессенджер честным.
OBSIDIAN_MAX_CONNECTIONS_PER_IP=32

# Сколько сокетов ВСЕГО может висеть, не назвавшись. Потолок общий, не на адрес:
# тысяча адресов по 32 сокета — это 32 тысячи, и память кончится раньше.
OBSIDIAN_MAX_UNAUTH_CONNECTIONS=4096

# Соединений с onion-входа целиком. Не «на адрес»: адреса у Tor-соединений нет,
# они считаются одним ведром — поэтому число больше обычного потолка.
OBSIDIAN_MAX_ONION_CONNECTIONS=512

# Во сколько раз щедрее лимиты частоты для этого общего ведра.
OBSIDIAN_ONION_LIMIT_FACTOR=20

# --- частота ----------------------------------------------------------------
OBSIDIAN_MAX_AUTH_ATTEMPTS=5
OBSIDIAN_MAX_AUTH_PER_MIN=20

# Попыток восстановления по паролю в час. Низкое значение намеренно: это
# единственный кадр без подписи, и за ним стоит личность целиком. Своих попыток
# нужно две-три, чужому — тысячи.
OBSIDIAN_MAX_RECOVERY_PER_HOUR=10

# Поисков по юзернейму в минуту. Каталог хранит хеши, но словарь имён невелик:
# без ограничителя его перебрали бы целиком за вечер.
OBSIDIAN_MAX_SEARCH_PER_MIN=20

# Отправка: 120 в минуту — это два сообщения в секунду непрерывно. Живой
# переписке столько не нужно, а скрипту этого мало, чтобы навредить.
OBSIDIAN_MAX_SEND_PER_MIN=120

# Постов в каналах в минуту. У них, в отличие от конвертов, нет TTL.
OBSIDIAN_MAX_POSTS_PER_MIN=20

# Каналов на личность: их заведение ничего не стоит, а место занимает.
OBSIDIAN_MAX_CHANNELS=20

# Чужих KeyPackages в час. Пакет одноразовый, и вычерпать чужой запас — способ
# не дать начать с человеком новую переписку. Первое число ограничивает того,
# кто берёт; второе защищает того, у кого берут, от десятка аккаунтов сразу.
OBSIDIAN_MAX_CLAIMS_PER_HOUR=60
OBSIDIAN_MAX_CLAIMS_PER_DEVICE_HOUR=120

# --- память и обслуживание ---------------------------------------------------
# Потолки карт в памяти: спасают от исчерпания памяти, а не ограничивают
# поведение — за это отвечают лимиты выше.
OBSIDIAN_MAX_RATE_KEYS=100000
OBSIDIAN_MAX_NONCES=50000

# Конверты на устройство. Считается по получателю, а не по отправителю: иначе
# десять аккаунтов сложатся и обойдут ограничение, которое его же и защищает.
OBSIDIAN_MAX_QUEUED_PER_DEVICE=5000

# Как часто подметать протухшее, секунды.
OBSIDIAN_CLEANUP_SEC=3600

# Подписанный манифест релизов. Ключа для его подписи на сервере нет и быть не
# должно — манифест приезжает уже подписанным.
OBSIDIAN_RELEASES_FILE=data/releases.json

# --- платный вход в TON (сейчас выключен) -------------------------------------
# Пусто => вход только по инвайтам, модули TON не загружаются вовсе.
# Чтобы включить: вписать сюда адрес обычного кошелька. Приватный ключ серверу
# не нужен — он только читает блокчейн. Пакеты должны быть установлены
# (npm ci без --omit=optional), а клиентское ядро собрано с --features ton.
OBSIDIAN_TON_ADDRESS=

# Цена в TON. Курсового оракула нет намеренно — это лишняя внешняя зависимость
# и лишний наблюдатель. Пересчитывай сам при движении курса.
OBSIDIAN_TON_PRICE=3.0

# Допуск на комиссии, базисные пункты: 200 = принимаем от 98% суммы.
OBSIDIAN_TON_TOLERANCE_BP=200
OBSIDIAN_TON_INVOICE_TTL_SEC=3600
OBSIDIAN_TON_POLL_SEC=20

# Свой лайтсервер = никто не видит, чей кошелёк опрашивается.
OBSIDIAN_TON_CONFIG=https://ton.org/global.config.json
